set-option -g status-interval 1
set-option -g display-time 5000
#set -g @plugin 'alexwforsythe/tmux-which-key'
#set -g @plugin 'tmux-plugins/tmux-sensible'
#set -g @plugin 'tmux-plugins/tpm'
#set -g @plugin 'tmux-plugins/tmux-sensible'
#set -g @plugin 'sainnhe/tmux-fzf'
#set -g @plugin 'omerxx/tmux-floax'
set -g default-terminal "tmux-256color"
set-option -g xterm-keys on
set -ga terminal-overrides ',fbterm:Sxl=\E[?1;0;0q:RGB:sitm=\E[3m,ritm=\E[23m:smul=\E[4m:rmul=\E[24m:smxx=\E[9m:rmxx=\E[29m'
set -ga terminal-overrides ',*256col*:Tc:RGB'
set -ga terminal-overrides ',tmux-256color:Sxl=\E[?1;0;0q:sitm=\E[3m,ritm=\E[23m:smul=\E[4m:rmul=\E[24m:smxx=\E[9m:rmxx=\E[29m'
set -as terminal-features ',fbterm*:sixel'
set -as terminal-features ',*256color*:sixel'
set -as terminal-overrides ',*:Sxl'
set -g history-limit 100000
set -g allow-passthrough on
set-option -ga terminal-overrides ",*:U8=0"
set-option -g lock-command vlock
#右下角
set-option -g status-right "#[bg=colour235,fg=colour237]#[bg=colour237,fg=colour254] #(/root/bin/im_status.sh) #[bg=colour237,fg=colour235]#[bg=colour235,fg=colour254] #(date '+%H:%M') #[bg=colour235,fg=colour237]#[bg=colour237,fg=color254] #(/root/bin/wifi_status)#(/root/bin/batt.sh) "
set-window-option -g mode-keys vi
setw -q -g utf8 on
#set-option -g status-left-length 20
set -g status-justify left
set -g popup-border-line none
set-option -g popup-style bg=color237,fg=color254

#左下角
set-option -g status-left-length 20
set-option -g status-left "#[bg=colour237,fg=colour119] ㉁ #[bg=colour235,fg=colour237]#[fg=colour237,bg=colour235]#[bg=color235,fg=colour15] #[fg=white][#S] "

# 窗口列表
setw -g automatic-rename on
set-window-option -g window-status-style bg=colour235,fg=colour237
#set-window-option -g window-status-current-format '#[fg=colour235,bg=clour235]#[bg=colour237] #[bg=colour237,fg=colour254]#I:#W #[bg=colour235,fg=colour237]'
set-window-option -g window-status-current-format '#[bg=colour237,fg=colour235]#[fg=colour235,bg=colour237] #[bg=colour237,fg=colour254]#I:#W #[bg=colour235,fg=colour237]'

set-window-option -g window-status-separator "#[bg="#202020",fg="black"]"

set -g status-bg colour235
set -g status-fg colour15
set -g pane-border-lines heavy

set-option -g message-command-style bg=colour15,fg=black,noreverse

set -g prefix F11

unbind C-b
bind F11 send-prefix

bind | split-window -h
bind - split-window -v

#bind -n F12 run-shell '/root/bin/toggle_screen.sh'
# F12 alone: cold warp -- save with the bootflag armed, then power off; comes
# back on the next POWER press down the U-Boot restore path.
bind -n F12 run-shell -b '/root/bin/coldwarp.sh >/dev/null 2>&1'
# F11+F12: ordinary shutdown, and it must boot ordinarily afterwards.  U-Boot's
# warp_checkboot() restores only when it sees W5HD at p5+0 AND W5BF at
# p5+0x20000, so drop W5BF (1KB block) and the WARPCLD marker at p5+0x1f000.
# Both would otherwise be left over: W5BF sends the next power-on into a cold
# restore, and a stale marker makes a later *hot* warp look like a cold one,
# which wrongly queues the bcmdhd reload.  W5HD at p5+0 is the blob header and
# must NOT be cleared -- without it warp stops working entirely.
bind F12 run-shell -b 'dd if=/dev/zero of=/dev/mmcblk0p5 bs=1024 seek=128 count=1 conv=notrunc 2>/dev/null; dd if=/dev/zero of=/dev/mmcblk0p5 bs=1 seek=126976 count=8 conv=notrunc 2>/dev/null; sync; sudo shutdown -h now'
#bind F6 run-shell 'fbgrab screenshot.png -s 5'
#bind F1 run-shell 'less /root/.help'
bind F11 display-popup -w 100% -h 30% -E "/root/bin/qsend"
#bind F2 display-popup -w 50% -h 40% -E "/usr/bin/todo /root/todolist"
#bind F2 display-popup -w 50% -h 40% -E "tewduwu"
#bind -n F11 display-popup -w 80% -h 15% -E "stty -ixon && true > /tmp/scratch && nvim -c startinsert -u ~/.vimhiderc /tmp/scratch && cat /tmp/scratch |flomo -new"
#bind F11 display-popup -w 80% -h 18% -E "stty -ixon && true > /tmp/scratch && nvim -c startinsert -u ~/.vimhiderc /tmp/scratch && cat /tmp/scratch |send_to_catnote.py"
#bind -n F11 run-shell '/root/bin/scrathpad.sh'
#bind -n F1 run-shell 'tmux send-key less\ /root/.help Enter'
bind F10 choose-window
bind z set-option -g status
#bind  Home copy-mode
bind  S-F1 copy-mode
bind  End paste-buffer
#bind  End paste-buffer
bind -n S-F1 run-shell -b "~/bin/toggle_fzf_menu.sh"
bind -n M-Tab next-window
#bind -n C-PageUp next-window
#bind -n C-PageDown previous-window

bind-key -N 'Toggle popup window' Escape if-shell -F '#{==:#{session_name},popup}' {
    set -t popup: status off
    detach-client
} {
#    display-popup -d "#{pane_current_path}" -xC -yC -w 100% -h 40% -E 'tmux attach-session -t popup || tmux new-session -s popup "aichat --simple"'
    display-popup -d "#{pane_current_path}" -xC -yC -w 100% -h 40% -E 'tmux has-session -t popup 2>/dev/null && tmux attach-session -t popup || (tmux new-session -d -s popup "aichat --simple" && tmux set -t popup status off && tmux attach-session -t popup)'
    set -t popup: status off
}
set-hook -g client-detached 'run-shell "truncate -s 0 /tmp/yong_status"'
set-hook -g session-closed 'run-shell "truncate -s 0 /tmp/yong_status"'
#run '~/.tmux/plugins/tpm/tpm'
